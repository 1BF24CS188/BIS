import random

# ---------------------------------------------------------
# Genetic Algorithm for 0/1 Knapsack Problem
# ---------------------------------------------------------

# Items
weights = [2, 3, 4, 5, 6]
values = [20, 30, 40, 50, 60]

capacity = 10


# ---------------------------------------------------------
# Create a binary chromosome
# ---------------------------------------------------------
def create_chromosome():
    return ''.join(random.choice('01') for _ in range(len(weights)))


# ---------------------------------------------------------
# Create initial population
# ---------------------------------------------------------
def create_population(population_size):
    return [create_chromosome() for _ in range(population_size)]


# ---------------------------------------------------------
# Calculate weight and value
# ---------------------------------------------------------
def calculate_weight_value(chromosome):

    total_weight = 0
    total_value = 0

    for i in range(len(chromosome)):

        if chromosome[i] == '1':
            total_weight += weights[i]
            total_value += values[i]

    return total_weight, total_value


# ---------------------------------------------------------
# Fitness Function
# ---------------------------------------------------------
def fitness(chromosome):

    total_weight, total_value = calculate_weight_value(chromosome)

    # If weight exceeds capacity, fitness = 0
    if total_weight > capacity:
        return 0

    return total_value


# ---------------------------------------------------------
# Selection - Roulette Wheel Selection
# ---------------------------------------------------------
def selection(population):

    fitness_values = [fitness(chromosome) for chromosome in population]

    total_fitness = sum(fitness_values)

    # If all fitness values are zero
    if total_fitness == 0:
        return random.choice(population)

    return random.choices(
        population,
        weights=fitness_values,
        k=1
    )[0]


# ---------------------------------------------------------
# Crossover
# ---------------------------------------------------------
def crossover(parent1, parent2, crossover_rate):

    # Check crossover probability
    if random.random() > crossover_rate:
        return parent1, parent2

    # Select crossover point
    point = random.randint(1, len(parent1) - 1)

    child1 = parent1[:point] + parent2[point:]
    child2 = parent2[:point] + parent1[point:]

    return child1, child2


# ---------------------------------------------------------
# Mutation
# ---------------------------------------------------------
def mutation(chromosome, mutation_rate):

    chromosome = list(chromosome)

    for i in range(len(chromosome)):

        if random.random() < mutation_rate:

            if chromosome[i] == '0':
                chromosome[i] = '1'
            else:
                chromosome[i] = '0'

    return ''.join(chromosome)


# ---------------------------------------------------------
# USER INPUT
# ---------------------------------------------------------

print("===== GENETIC ALGORITHM - KNAPSACK =====")

print("\nItems:")
for i in range(len(weights)):
    print(
        f"Item {i + 1}: "
        f"Weight = {weights[i]} kg, "
        f"Value = {values[i]}"
    )

print("\nKnapsack Capacity =", capacity, "kg")

population_size = int(input("\nEnter population size: "))
crossover_rate = float(input("Enter crossover probability (0-1): "))
mutation_rate = float(input("Enter mutation probability (0-1): "))
generations = int(input("Enter number of generations: "))


# Validate probability
if not 0 <= crossover_rate <= 1:
    print("Crossover probability must be between 0 and 1.")
    exit()

if not 0 <= mutation_rate <= 1:
    print("Mutation probability must be between 0 and 1.")
    exit()


# ---------------------------------------------------------
# INITIAL POPULATION
# ---------------------------------------------------------

population = create_population(population_size)

best_chromosome = None
best_fitness = 0


# ---------------------------------------------------------
# GENETIC ALGORITHM
# ---------------------------------------------------------

for generation in range(generations):

    # Calculate fitness
    fitness_values = [
        fitness(chromosome)
        for chromosome in population
    ]

    # Find best chromosome in current generation
    best_index = fitness_values.index(max(fitness_values))

    generation_best = population[best_index]
    generation_best_fitness = fitness(generation_best)

    # Update overall best
    if generation_best_fitness > best_fitness:

        best_fitness = generation_best_fitness
        best_chromosome = generation_best

    print("\n====================================")
    print("Generation", generation + 1)
    print("====================================")

    for chromosome in population:

        weight, value = calculate_weight_value(chromosome)

        print(
            f"Chromosome = {chromosome} "
            f"| Weight = {weight} "
            f"| Value = {value} "
            f"| Fitness = {fitness(chromosome)}"
        )

    print("\nBest chromosome:",
          generation_best)

    print("Best fitness:",
          generation_best_fitness)

    # -----------------------------------------------------
    # Create new population
    # -----------------------------------------------------

    new_population = []

    # Elitism
    new_population.append(generation_best)

    while len(new_population) < population_size:

        # Selection
        parent1 = selection(population)
        parent2 = selection(population)

        # Crossover
        child1, child2 = crossover(
            parent1,
            parent2,
            crossover_rate
        )

        # Mutation
        child1 = mutation(
            child1,
            mutation_rate
        )

        child2 = mutation(
            child2,
            mutation_rate
        )

        # Add children
        new_population.append(child1)

        if len(new_population) < population_size:
            new_population.append(child2)

    # Replace old population
    population = new_population


# ---------------------------------------------------------
# FINAL RESULT
# ---------------------------------------------------------

print("\n\n====================================")
print("FINAL RESULT")
print("====================================")

best_weight, best_value = calculate_weight_value(
    best_chromosome
)

print("Best Chromosome :", best_chromosome)
print("Total Weight    :", best_weight, "kg")
print("Total Value     :", best_value)
print("Fitness         :", best_fitness)

print("\nSelected Items:")

for i in range(len(best_chromosome)):

    if best_chromosome[i] == '1':
        print(
            f"Item {i + 1}: "
            f"Weight = {weights[i]} kg, "
            f"Value = {values[i]}"
        )
